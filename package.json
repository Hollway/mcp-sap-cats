{
  "name": "mcp-sap-cats",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for SAP CATS timesheets (transaction CAT2) over a custom ICF handler",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sap-cats": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector node ./dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
