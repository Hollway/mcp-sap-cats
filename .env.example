# Базовый URL ICF-узла в целевой системе (узел заводится БЕЗ сохранённых данных логона)
SAP_CATS_URL=https://<sap-host>/<SID>/sap/bc/zcats

# Мандант
SAP_CLIENT=102

# Учётные данные пробрасываются в SAP как есть: авторизацию выполняет сам SAP,
# круг доступных табельных номеров определяют полномочия этого пользователя.
SAP_USER=
SAP_PASSWORD=

# Профиль ввода данных по умолчанию: TIME_D1 | TIME_W1 | TIME_M1
SAP_CATS_PROFILE=TIME_D1

# Корневой сертификат корпоративного CA — без него самоподписанный
# сертификат SAP-хоста не пройдёт проверку.
# NODE_EXTRA_CA_CERTS=C:\Tools\certs\corp-root-ca.pem

# Прокси. Внутренние адреса должны быть в NO_PROXY, иначе headless-процесс
# не достучится там, где достукивается GUI.
# HTTPS_PROXY=http://<corp-proxy-host>:3128
# NO_PROXY=<sap-host>,<sap-ip>,localhost

# Таймаут одного обращения к хендлеру, мс
# SAP_TIMEOUT_MS=60000

# Повторы при LR2 «Транзакцию блокирует пользователь» и пауза перед первым
# повтором (каждый следующий — дольше), мс
# SAP_LOCK_RETRIES=2
# SAP_LOCK_RETRY_DELAY_MS=2000
